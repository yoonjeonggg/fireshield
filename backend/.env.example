DATABASE_URL=postgresql+asyncpg://fireshield:fireshield_dev_pw@localhost:5432/fireshield
LAW_API_KEY=your-law-go-kr-api-key
LAW_API_BASE_URL=https://www.law.go.kr/DRF/lawSearch.do
ENCRYPTION_KEY=generate-with-python-c-import-secrets-base64-secrets-token-bytes-32
CORS_ORIGINS=http://localhost:3000
ADMIN_API_KEY=generate-a-random-secret

# AI(로컬 LLM) 사기 판정 — Ollama 필요 (https://ollama.com)
# 모델 준비:  ollama pull gemma2:2b
# 끄려면:     AI_ENABLED=false  (그러면 규칙 점수만 사용)
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
AI_TIMEOUT_SECONDS=15
OLLAMA_KEEP_ALIVE=30m
# CPU 추론 스레드 수 (비우면 Ollama 기본값). 논리 코어 수로 맞추면 CPU 환경에서 빨라질 수 있음
OLLAMA_NUM_THREAD=
AI_CONFLICT_GAP=45

# /verify 요청 횟수 제한 (IP당 1분 허용 횟수, 0이면 끔)
VERIFY_RATE_LIMIT_PER_MINUTE=10
# 리버스 프록시 뒤에서만 true (X-Forwarded-For의 마지막 값을 클라이언트 IP로 사용)
TRUST_FORWARDED_FOR=false
# 진위확인 로그 보관 기간(일). 지나면 자동 삭제. FRAUD_CHECK_WINDOW_DAYS(기본 90) 이상이어야 함
VERIFY_LOG_RETENTION_DAYS=180
