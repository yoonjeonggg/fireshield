DATABASE_URL=postgresql+asyncpg://fireshield:fireshield_dev_pw@localhost:5432/fireshield
LAW_API_KEY=your-law-go-kr-api-key
LAW_API_BASE_URL=https://www.law.go.kr/DRF/lawSearch.do
ENCRYPTION_KEY=generate-with-python-c-import-secrets-base64-secrets-token-bytes-32
CORS_ORIGINS=http://localhost:3000
ADMIN_API_KEY=generate-a-random-secret

# AI(로컬 LLM) 사기 판정 — Ollama 필요 (https://ollama.com)
# 모델 준비:  ollama pull gemma2:2b
# 끄려면:     AI_ENABLED=false  (그러면 규칙 점수만 사용)
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
AI_TIMEOUT_SECONDS=15
OLLAMA_KEEP_ALIVE=30m
AI_CONFLICT_GAP=45
